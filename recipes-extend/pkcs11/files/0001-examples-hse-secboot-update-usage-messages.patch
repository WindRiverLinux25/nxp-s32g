From 0d1e6399f067b29ad91745c27647764e5c18037a Mon Sep 17 00:00:00 2001
From: Zhantao Tang <zhantao.tang@windriver.com>
Date: Sat, 15 Mar 2025 03:25:05 +0000
Subject: [PATCH] examples: hse-secboot: update usage messages

Update usage messages to compatible with wrlinux image settings.

Upstream-Status: Inappropriate [WR Linux specific]

Signed-off-by: Zhantao Tang <zhantao.tang@windriver.com>
---
 examples/hse-secboot/hse-secboot.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/examples/hse-secboot/hse-secboot.c b/examples/hse-secboot/hse-secboot.c
index fe15601..6926c83 100644
--- a/examples/hse-secboot/hse-secboot.c
+++ b/examples/hse-secboot/hse-secboot.c
@@ -2026,8 +2026,8 @@ void usage(char *progname)
 	printf("\nformat HSE key catalogs or set up HSE-based advanced secure boot\n\n");
 	printf("Example: hse-secboot -s -d /dev/mmcblk0 --bl2_key /etc/keys/secboot/bl2_rsa2048_public.pem ");
 	printf("--bl31_key -:0x010700 --bl33_key -:0x010700 ");
-	printf("--bl2_sign /etc/keys/secboot/bl2-signature.bin-sdcard ");
-	printf("--bl2_bin /etc/keys/secboot/bl2_w_dtb.bin-sdcard");
+	printf("--bl2_sign /boot/secboot/<bl2-sign-file> ");
+	printf("--bl2_bin /boot/secboot/<bl2-bin-file>");
 	printf("\n");
 	printf("Usage:\n");
 	printf("\n");
@@ -2049,7 +2049,7 @@ void usage(char *progname)
 	printf("\t\t\t    sd - SD card boot (default)\n");
 	printf("\t\t\t  qspi - QSPI Flash boot\n");
 	printf("\t\t\t   mmc - MMC or eMMC boot\n");
-	printf("\t-d:\tspecify full path to SD/MMC/MTD device (e.g. /dev/sdb or /dev/mtd0)\n");
+	printf("\t-d:\tspecify full path to SD/MMC/MTD device (e.g. /dev/mmcblk0 or /dev/mtd0)\n");
 	printf("\t-e:\tuse ECC keys and ECDSA signature for BL2 and BL3X images\n");
 	printf("\t--rpmb_key: specify full path to symmetric key file for Rollback Protection and HSE key slot,\n");
 	printf("\t            if this option is present, the HSE Monotonic Counter Table will be generated\n");
-- 
2.43.0

