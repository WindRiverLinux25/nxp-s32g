From c002e2f50347cf33d2c91e3bb09b79bd30743554 Mon Sep 17 00:00:00 2001
From: Pritam Srichandan Sahoo <PritamSrichandan.Sahoo@windriver.com>
Date: Thu, 20 Aug 2026 07:10:58 +0000
Subject: [PATCH 1/2] gpio: gpiolib: re-export gpiochip_irq_map() and
 gpiochip_irq_unmap()

Partial revert of commit 88b7049635dc (\"gpio: unexport GPIO irq domain
functions only used internally\").

The NXP S32G siul2 GPIO driver (gpio-siul2-s32cc.c) needs these functions
to set up its custom irq_domain_ops with proper .map/.unmap callbacks.
Without them, request_threaded_irq() fails with -ENOSYS for any device
using a GPIO-based interrupt through the siul2 controller.

Re-export only gpiochip_irq_map() and gpiochip_irq_unmap().

Upstream-Status: Backport [WRLinux LTS24 kernel v6.6/standard/nxp-sdk-6.6/nxp-s32g]
Signed-off-by: Pritam Srichandan Sahoo <PritamSrichandan.Sahoo@windriver.com>
---
 drivers/gpio/gpiolib.c      | 8 ++++++--
 include/linux/gpio/driver.h | 4 ++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/drivers/gpio/gpiolib.c b/drivers/gpio/gpiolib.c
index 81b83b058770..4b3224241382 100644
--- a/drivers/gpio/gpiolib.c
+++ b/drivers/gpio/gpiolib.c
@@ -1711,7 +1711,7 @@ static bool gpiochip_hierarchy_is_hierarchical(struct gpio_chip *gc)
  * Returns:
  * 0 on success, or negative errno on failure.
  */
-static int gpiochip_irq_map(struct irq_domain *d, unsigned int irq,
+int gpiochip_irq_map(struct irq_domain *d, unsigned int irq,
 			    irq_hw_number_t hwirq)
 {
 	struct gpio_chip *gc = d->host_data;
@@ -1750,7 +1750,9 @@ static int gpiochip_irq_map(struct irq_domain *d, unsigned int irq,
 	return 0;
 }
 
-static void gpiochip_irq_unmap(struct irq_domain *d, unsigned int irq)
+EXPORT_SYMBOL_GPL(gpiochip_irq_map);
+
+void gpiochip_irq_unmap(struct irq_domain *d, unsigned int irq)
 {
 	struct gpio_chip *gc = d->host_data;
 
@@ -1760,6 +1762,8 @@ static void gpiochip_irq_unmap(struct irq_domain *d, unsigned int irq)
 	irq_set_chip_data(irq, NULL);
 }
 
+EXPORT_SYMBOL_GPL(gpiochip_irq_unmap);
+
 static const struct irq_domain_ops gpiochip_domain_ops = {
 	.map	= gpiochip_irq_map,
 	.unmap	= gpiochip_irq_unmap,
diff --git a/include/linux/gpio/driver.h b/include/linux/gpio/driver.h
index ef246beb0223..48dbf12dedbd 100644
--- a/include/linux/gpio/driver.h
+++ b/include/linux/gpio/driver.h
@@ -805,6 +805,10 @@ struct gpio_chip *gpio_device_get_chip(struct gpio_device *gdev);
 int gpiochip_lock_as_irq(struct gpio_chip *gc, unsigned int offset);
 void gpiochip_unlock_as_irq(struct gpio_chip *gc, unsigned int offset);
 
+/* IRQ domain map/unmap helpers for GPIO drivers with custom domain_ops */
+int gpiochip_irq_map(struct irq_domain *d, unsigned int irq, irq_hw_number_t hwirq);
+void gpiochip_irq_unmap(struct irq_domain *d, unsigned int irq);
+
 struct gpio_chip *gpiod_to_chip(const struct gpio_desc *desc);
 struct gpio_device *gpiod_to_gpio_device(struct gpio_desc *desc);
 
-- 
